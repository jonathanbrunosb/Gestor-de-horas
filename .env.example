# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=

# Chave publica "anon" do Supabase (Project Settings > API > anon public)
# Esta chave fica exposta no bundle publicado no GitHub Pages — nunca use a service_role key aqui.
VITE_SUPABASE_ANON_KEY=

VITE_APP_NAME=Gestor de Horas

# Opcional — só preencha depois de publicar a Edge Function
# supabase/functions/log-audit-event (ver README, seção "Trilha de
# Auditoria"). Enquanto vazia, a auditoria grava direto na tabela
# audit_logs (chave anon) e o IP aparece como "Não capturado" na tela —
# nenhuma tentativa de rede é feita contra uma função que não existe.
# Formato: https://SEU-PROJETO.supabase.co/functions/v1/log-audit-event
VITE_AUDIT_EDGE_FUNCTION_URL=
